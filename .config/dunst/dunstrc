[global]
    font = RobotoMono 12

    allow_markup = yes

    format = "[ %a ]\n[ %s ]\n[ %b ]"

    sort = yes

    indicate_hidden = yes

    alignment = center

    bounce_freq = 0

    show_age_threshold = 60

    word_wrap = yes

    ignore_newline = no

    geometry = "0x5+10+150"

    shrink = yes

    # No `transparency` key: it is deprecated, the alpha lives in the colours.
    idle_threshold = 20

    monitor = 0

    follow = mouse

    sticky_history = yes

    show_indicators = yes

    line_height = 0

    separator_height = 4

    padding = 4

    horizontal_padding = 4

    # 4px white accent line between summary and body.
    separator_color = "#ffffff"

    startup_notification = false

    # Opaque, like every other window on this box (picom composites everything
    # at 1.0 - see ~/.config/picom/picom.conf).  dunst draws its own
    # transparency and picom's rules never reach these windows, so if the UI
    # ever goes glass again the alpha has to be written here as well: this used
    # to be #12121299 (60%) to match the old uniform UI transparency.
    background = "#121212"

    foreground = "#ffffff"

[frame]
    width = 4

[urgency_low]
    frame_color = "#666666"
    timeout = 10

[urgency_normal]
    frame_color = "#ffffff"
    timeout = 10

[urgency_critical]
    frame_color = "#ff0000"
    timeout = 0
