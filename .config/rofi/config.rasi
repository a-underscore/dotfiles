configuration {
	sorting-method: "fzf"; sort: true;
	disable-history: true;
	threads: 0;
	modi: "combi,window";
	case-sensitive: true;
	combi-modi: "run,drun";
	font: "RobotoMono 12";
	kb-accept-alt: "Control+Return";
	kb-accept-custom: "Shift+Return";
	kb-accept-custom-alt: "Control+Shift+Return";
	kb-remove-char-back: "BackSpace";
	terminal: "alacritty";
}
* {
    red:                         #ff0000;
    white: 			 #ffffff;
    gray:                  	 #009999;
    darkishgray:                 #333333;
    darkgray:                  	 #666666;
    darkergray:                  #121212;
    thickness:              	 4px;
    side-thickness:              3px;
    half-thickness:              2px;
    fourth-thickness:            1px;
    txt-color: 			 var(white);
    selected-active-background:  var(gray);
    separator-color:             var(gray);
    alternate-urgent-background: var(urgent-background);
    normal-background:           var(darkishgray);
    background:                  var(darkergray);
    selected-urgent-background:  var(red);
    alternate-active-background: var(selected-active-background);
    urgent-background:           var(red);
    active-background:           var(darkgray);
    selected-normal-background:  var(gray);
    alternate-normal-background: var(normal-background);
}
element {
    margin: var(fourth-thickness);
    padding: var(half-thickness);
    spacing: 0;
    border:  0;
}
element normal.normal {
    background-color: var(normal-background);
    text-color:       var(txt-color);
}
element normal.urgent {
    background-color: var(urgent-background);
    text-color:       var(txt-color);
}
element normal.active {
    background-color: var(active-background);
    text-color:       var(txt-color);
}
element selected.normal {
    background-color: var(selected-normal-background);
    text-color:       var(txt-color);
}
element selected.urgent {
    background-color: var(selected-normal-background);
    text-color:       var(txt-color);
}
element selected.active {
    background-color: var(selected-active-background);
    text-color:       var(txt-color);
}
element alternate.normal {
    background-color: var(alternate-normal-background);
    text-color:       var(txt-color);
}
element alternate.urgent {
    background-color: var(alternate-normal-background);
    text-color:       var(txt-color);
}
element alternate.active {
    background-color: var(active-background);
    text-color:       var(txt-color);
}
element-text {
    background-color: transparent;
    highlight:        none;
    text-color:       inherit;
}
element-icon {
    background-color: transparent;
    text-color:       var(white);
}
window {
    padding:          0;
    margin:           0;
    border-color:     var(gray);
    border:           var(thickness);
}
mainbox {
    padding: 0;
    margin: var(side-thickness);
}
message {
    margin: 0;
    padding:      0;
    border:       0;
}
textbox {
    background-color: var(active-background);
    text-color: var(txt-color);
}
listview {
    scrollbar:    false;
    padding: 0;
    border: 0;
}
sidebar {
    border:       0;
}
button {
    spacing:    0;
    text-color: var(txt-color);
}
button selected {
    background-color: var(selected-normal-background);
    text-color:       var(txt-color);
}
num-filtered-rows {
    expand:     false;
    text-color: var(txt-color);
}
num-rows {
    expand:     false;
    text-color: var(txt-color);
}
textbox-num-sep {
    expand:     false;
    str:        "/";
    text-color: var(txt-color);
}
inputbar {
    margin: var(fourth-thickness);
    text-color: var(txt-color);
    padding: 0;
}
case-indicator {
    spacing:    0;
    text-color: var(txt-color);
}
entry {
    text-color:        var(txt-color);
    spacing:           0;
    padding:           0;
    border:    	       0;
    placeholder-color: var(txt-color);
    placeholder:       "";
}
prompt {
    spacing:    0;
    text-color: var(txt-color);
}
textbox-prompt-colon {
    margin:     0;
    expand:     false;
    str:        " % ";
    text-color: inherit;
}
