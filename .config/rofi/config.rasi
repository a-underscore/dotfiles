configuration {
	sorting-method: "fzf";
	sort: true;
	disable-history: true;
	threads: 0;
	modi: "combi,window,run,drun";
	case-sensitive: true;
	combi-modi: "run,drun";
	font: "RobotoMono 12";
	kb-accept-alt: "Control+Return";
	kb-accept-custom: "Shift+Return";
	kb-accept-custom-alt: "Control+Shift+Return";
	kb-remove-char-back: "BackSpace";
	terminal: "alacritty";
}
* {
    urgent:                      #ff0000;
    txt: 			 #ffffff;
    cyan:                  	 #008080;
    unfocused:                   #333333;
    inactive:                  	 #666666;
    bg:                  	 #121212;
    thickness:              	 4px;
    thicknessmargin:             0 0 2px 0;
    background: 		 var(bg);
}
#scrollbar {
	width: var(thickness);
	border: 0;
	handle-thickness: var(thickness);
	handle-color: var(cyan);
	padding: 0 0 0 2px;
}
element {
    margin: var(thicknessmargin);
    padding: var(thickness);
    border:  0;
}
element normal.normal {
    background-color: var(unfocused);
    text-color:       var(txt);
}
element normal.urgent {
    background-color: var(urgent);
    text-color:       var(txt);
}
element normal.active {
    background-color: var(inactive);
    text-color:       var(txt);
}
element selected.normal {
    background-color: var(cyan);
    text-color:       var(txt);
}
element selected.urgent {
    background-color: var(cyan);
    text-color:       var(txt);
}
element selected.active {
    background-color: var(cyan);
    text-color:       var(txt);
}
element alternate.normal {
    background-color: var(unfocused);
    text-color:       var(txt);
}
element alternate.urgent {
    background-color: var(unfocused);
    text-color:       var(txt);
}
element alternate.active {
    background-color: var(inactive);
    text-color:       var(txt);
}
element-text {
    background-color: transparent;
    highlight:        none;
    text-color:       inherit;
}
element-icon {
    background-color: transparent;
    text-color:       var(txt);
}
window {
    padding:          0;
    margin:           0;
    border-color:     var(cyan);
    border:           var(thickness);
}
mainbox {
    padding: var(thickness);
    margin: 0; 
}
message {
    margin: 	  0;
    padding:      0;
    border:       0;
}
textbox {
    background-color: var(inactive);
    text-color: var(txt);
}
listview {
    scrollbar:    true;
    padding: 0;
    border: 0;
}
sidebar {
    border:       0;
}
button {
    spacing:    0;
    text-color: var(txt);
}
button selected {
    background-color: var(cyan);
    text-color:       var(txt);
}
num-filteurgent-rows {
    expand:     false;
    text-color: var(txt);
}
num-rows {
    expand:     false;
    text-color: var(txt);
}
textbox-num-sep {
    expand:     false;
    str:        "/";
    text-color: var(txt);
}
inputbar {
    margin: 0;
    text-color: var(txt);
    padding: 0;
}
case-indicator {
    spacing:    0;
    text-color: var(txt);
}
entry {
    text-color:        var(txt);
    spacing:           0;
    padding:           0;
    border:    	       0;
    placeholder-color: var(txt);
    placeholder:       "";
}
prompt {
    spacing:    0;
    text-color: var(txt);
}
textbox-prompt-colon {
    margin:     0;
    expand:     false;
    str:        " % ";
    text-color: inherit;
}
