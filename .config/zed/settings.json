// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent_servers": {
    "crow-cli": {
      "type": "custom",
      "command": "/home/a_/.local/bin/crow-cli",
      "args": ["acp"],
      "env": {}
    },
    "astolfo3": {
      "type": "custom",
      "command": "ssh",
      "args": ["-o", "BatchMode=yes", "-o", "StrictHostKeyChecking=accept-new", "mc-server@192.168.1.162", "python3", "/home/mc-server/.zeroclaw/agents/astolfo3/workspace/acp_wrap.py"],
      "env": {}
    }
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "cli_default_open_behavior": "existing_window",
  "agent": {
    "sidebar_side": "right",
    "dock": "right",
    "default_model": {
      "effort": "medium",
      "provider": "zed.dev",
      "model": "gpt-5.3-codex",
      "enable_thinking": true
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "base_keymap": "VSCode",
  "relative_line_numbers": "enabled",
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "theme2"
  },
}
