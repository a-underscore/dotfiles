#!/bin/sh

white=ffffff
font="RobotoMono"
size=12
cyan=008080
red=ff0000
lightgray=666666
gray=333333
darkgray=121212
# The unlock indicator: the outer ring and the centre are both solid
# $lightgray, and the wrong-password / backspace feedback is solid $red - the
# lock screen has no translucency left anywhere.  One value drives the ring and
# the centre together, so they always match.
# The screen itself is the opaque -c $darkgray fill, not a blurred screenshot:
# no -B/--blur, because that captures the desktop and shows it back (blurred =
# still the desktop) - which is the same "nothing shows through" rule the rest
# of this desktop follows (picom active/inactive-opacity are 1.0, see
# ~/.config/picom/picom.conf).
# To bring glass back, change the alpha byte - 00 see-through,
# 66 = 40%, 80 = 50%, 99 = 60%, cc = 80%, ff = solid (the current value) - and
# put -B 15 back on the i3lock line below, or the indicator would be glass over
# a flat fill.
# The alpha byte is written explicitly (rrggbbaa - the documented 4-byte form)
# rather than relying on a bare rrggbb being padded to ff.
glass=${lightgray}ff
glassred=${red}ff

! pidof i3lock > /dev/null && i3lock --time-font $font --time-size $size --time-color $white --date-font $font --date-size $size --date-color $white --verif-font $font --verif-size $size --verif-color $white --wrong-font $font --wrong-size $size --wrong-color $white --greeter-font $font --greeter-size $size --greeter-color $white \
-c ${darkgray}ff --inside-color $glass --ring-color $glass --ringver-color $gray --ringver-color $cyan --insidever-color $cyan --insidewrong-color $glassred --ringwrong-color $glassred --keyhl-color $cyan --bshl-color $glassred --time-str="%H:%M:%S" \
  --time-str="[ %H:%M:%S ]" \
  --date-str="[ %A %e %B %Y ]" \
  --verif-text="[ Checking... ]" \
  --wrong-text="[ Wrong pswd ]" \
  --noinput="[ No Input ]" \
  --lock-text="[ Locking... ]" \
  --lockfailed="[ Lock Failed ]" \
  --radius=120 \
  --ring-width=10 \
  --clock \
  --indicator \
  --no-modkey-text \ && exit 0

exit 1
